  fill(0,0,0);
  ellipse(180,300,100,50);
  fill(0,0,0);
  ellipse(220,300,100,50);
  fill(255,255,255);
  ellipse(150,290,100,60);
  fill(255,255,255);
  ellipse(250,290,100,60);
